# Copy to /etc/lutung.env on the server (chmod 600, owner root). Never commit the real file.
LUTUNG_ENV=production
LUTUNG_DB_PATH=/var/lib/lutung/lutung.db

# Public Firebase web configuration. Keep real values in /etc/lutung.env, not Git.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Inference providers. Leave URL empty to show the service as unavailable instead of failing silently.
LUTUNG_PROVIDER_DOCUMENT_DETECTION_URL=
LUTUNG_PROVIDER_DOCUMENT_DETECTION_TOKEN=
LUTUNG_PROVIDER_OCR_KTP_URL=
LUTUNG_PROVIDER_OCR_KTP_TOKEN=

# Comma-separated slugs to force into maintenance.
LUTUNG_DISABLED=

# Google accounts that can use trial playgrounds without the one-success cap.
# The address must match a verified Google sign-in. Rate limits still apply. Restart the service after editing.
LUTUNG_ADMIN_EMAILS=
